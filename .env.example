# Скопируйте в .env. Без LLM сервис работает в офлайн-режиме на каталоге из 15 работ.

# Каталог данных: лабораторные, версии, результаты проверки, база пользователей (app.db)
LABGEN_DATA_DIR=data

# Секрет для сессий и шифрования API-ключей пользователей.
# Если не задан, создаётся автоматически в data/secret.key. При смене секрета
# сохранённые ключи LLM придётся ввести заново.
LABGEN_SECRET_KEY=

# Разрешить регистрацию новых пользователей (0 — только существующие аккаунты)
LABGEN_ALLOW_REGISTRATION=1

# --- LLM для командной строки (в веб-интерфейсе у каждого пользователя свои ключи) ---
# Провайдер: anthropic | openai | local
LABGEN_LLM_PROVIDER=
LABGEN_LLM_MODEL=
LABGEN_LLM_API_KEY=
# Для local — адрес OpenAI-совместимого сервера, например Ollama:
LABGEN_LLM_BASE_URL=
# Примеры:
#   LABGEN_LLM_PROVIDER=anthropic  LABGEN_LLM_MODEL=claude-sonnet-5-5  LABGEN_LLM_API_KEY=sk-ant-...
#   LABGEN_LLM_PROVIDER=openai     LABGEN_LLM_MODEL=gpt-5-mini         LABGEN_LLM_API_KEY=sk-...
#   LABGEN_LLM_PROVIDER=local      LABGEN_LLM_MODEL=qwen2.5-coder:14b  LABGEN_LLM_BASE_URL=http://localhost:11434/v1

LABGEN_LLM_JSON_MODE=1
LABGEN_LLM_TIMEOUT=240
# Пусто — температура по умолчанию модели (рассуждающие модели OpenAI не принимают другую)
LABGEN_LLM_TEMPERATURE=

# Сколько раз агент может исправлять работу по замечаниям проверки
LABGEN_MAX_ATTEMPTS=3
# Число симулированных студентов по умолчанию (0 — не запускать)
LABGEN_SIMULATE_STUDENTS=0
