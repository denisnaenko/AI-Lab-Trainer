# Скопируйте в .env и заполните. Без LLM сервис работает в офлайн-режиме на каталоге.

# Каталог для хранения лабораторных, версий и результатов проверки
LABGEN_DATA_DIR=data

# --- LLM: любой OpenAI-совместимый Chat Completions API -------------------------
# OpenAI:
# LABGEN_LLM_BASE_URL=https://api.openai.com/v1
# LABGEN_LLM_API_KEY=sk-...
# LABGEN_LLM_MODEL=gpt-4o-mini
#
# Локальная модель через Ollama (ключ не нужен):
# LABGEN_LLM_BASE_URL=http://localhost:11434/v1
# LABGEN_LLM_MODEL=qwen2.5-coder:14b
LABGEN_LLM_BASE_URL=
LABGEN_LLM_API_KEY=
LABGEN_LLM_MODEL=

# Просить у модели ответ в режиме JSON (отключите, если сервер не поддерживает response_format)
LABGEN_LLM_JSON_MODE=1
LABGEN_LLM_TEMPERATURE=0.2
LABGEN_LLM_TIMEOUT=180

# Сколько раз генератор может исправлять работу по замечаниям валидатора
LABGEN_MAX_ATTEMPTS=3
# Число симулированных студентов по умолчанию (0 — не запускать)
LABGEN_SIMULATE_STUDENTS=0
